
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Allegro",
            "type": "process",
            "command": "C:/msys64/ucrt64/bin/gcc.exe",
            "args": [
                "-g",
                "-Wall",
                "-std=c17",
                "${workspaceFolder}/src/telainicio.c",
                "${workspaceFolder}/src/camera.c",
                "${workspaceFolder}/src/colisao.c",
                "${workspaceFolder}/src/mapa.c",
                "${workspaceFolder}/src/personagem.c",
                "${workspaceFolder}/src/interacao.c",
                "${workspaceFolder}/src/missaoCasa.c",
                "${workspaceFolder}/src/missaoMercado.c",
                "${workspaceFolder}/src/missaoRuinas.c",
                "${workspaceFolder}/src/templo.c",
                "${workspaceFolder}/src/curiosidades.c",
                "-o",
                "${workspaceFolder}/telainicio.exe",
                "-lallegro_video",
                "-lallegro_primitives",
                "-lallegro_font",
                "-lallegro_ttf",
                "-lallegro_image",
                "-lallegro_audio",
                "-lallegro_acodec",
                "-lallegro_dialog",
                "-lallegro",
                "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
                }
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
